{
  "name": "deudas-familiares",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace=@deudas/core && npm run build --workspace=@deudas/web && npm run build --workspace=@deudas/api",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "trazabilidad": "node scripts/verificar-trazabilidad.mjs",
    "verificar": "npm run lint && npm run trazabilidad && npm test",
    "e2e": "playwright test",
    "dev:web": "npm run dev --workspace=@deudas/web",
    "dev:api": "npm run build --workspace=@deudas/core && npm run dev --workspace=@deudas/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/utils": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
